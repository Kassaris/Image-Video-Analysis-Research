# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/

# IDE / editors
.vscode/
.idea/

# Environment variables / secrets
.env
.env.*
!.env.example

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# Logs / temporary files
*.log
*.tmp
*.temp
~$*

# Python testing / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Large archives / generated packages
*.zip
*.tar
*.tar.gz
*.7z

# ML model/checkpoint files (usually too large for normal Git)
*.h5
*.hdf5
*.ckpt
*.pth
*.pt
*.onnx

# NOTE:
# data/ and figures/ are intentionally NOT ignored.
# Keep useful small datasets and research figures in the repository.
